{
  "version": 2,
  "builds": [
    {
      "src": "porto.php",
      "use": "vercel-php"
    },
    {
      "src": "foto/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/foto/(.*)",
      "dest": "/foto/$1"
    },
    {
      "src": "/((?!foto/).*)",
      "dest": "/porto.php"
    }
  ]
}
